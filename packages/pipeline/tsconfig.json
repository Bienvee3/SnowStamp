{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "declaration": true,
    "types": ["node"],
    "outDir": "dist",
    "rootDir": "..",
    "paths": { "@snowstamp/domain": ["../domain/src/index.ts"] }
  },
  "include": ["src", "test"]
}
